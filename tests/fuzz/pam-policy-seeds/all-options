issuer=https://idp.example/
audience=postgres://primary,postgres://replica
scope=connect:postgres extra:scope
algorithms=RS256,ES256,EdDSA
token_types=at+jwt,application/at+jwt
allow_missing_token_type=off
identity_claim=sub
clock_skew_ms=60000
max_token_size=65530
jwks_hosts=keys.example,cdn.example
ca_file=/etc/pki/tls/certs/ca.pem
metadata_default_ttl_ms=300000
jwks_default_ttl_ms=300000
cache_max_ttl_ms=3600000
jwks_stale_grace_ms=60000
unknown_kid_refresh_cooldown_ms=30000
refresh_wait_timeout_ms=5000
allow_insecure_http=off