ARG POSTGRES_IMAGE=postgres:18.7-bookworm@sha256:194e55feb2597b1465dbee81cc9fd8d204566cd2eb42c8d22fd6c931a38781b1
FROM ${POSTGRES_IMAGE}

ARG PG_MAJOR=18
WORKDIR /workspace
COPY scripts/ci/install-debian-dependencies.sh scripts/ci/install-jansson.sh scripts/ci/install-libjwt.sh scripts/ci/

RUN ./scripts/ci/install-debian-dependencies.sh "$PG_MAJOR" \
    && apt-get install --yes --no-install-recommends \
         libpq-oauth=18.7-1.pgdg12+5 \
         python3-yaml=6.0-3+b2 \
    && ./scripts/ci/install-jansson.sh \
    && ./scripts/ci/install-libjwt.sh \
    && rm -rf /var/lib/apt/lists/*

COPY . .
COPY demo /demo

RUN make PG_CONFIG="/usr/lib/postgresql/$PG_MAJOR/bin/pg_config" clean \
    && make PG_CONFIG="/usr/lib/postgresql/$PG_MAJOR/bin/pg_config" all \
    && make PG_CONFIG="/usr/lib/postgresql/$PG_MAJOR/bin/pg_config" install \
    && make PG_CONFIG="/usr/lib/postgresql/$PG_MAJOR/bin/pg_config" clean

WORKDIR /
